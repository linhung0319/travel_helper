// Cloudflare Worker 的設定（T24：D1；T25：網站的靜態檔案、部署）。
// secret（LINE、SESSION_SECRET、PUBLIC_BASE_URL、ADMIN_LINE_USER_IDS）不寫在這裡：
// 本機放 worker/.env，正式環境用 `npx wrangler secret put <名稱>`（architecture §4「設定值和 secret」）。
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "travel-helper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 正式網址是 https://travel-helper.<帳號的子網域>.workers.dev
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-helper",
      // 本機（--local、wrangler dev）不會用到這個 ID；第一次部署前換成 `wrangler d1 create travel-helper` 印出的 ID
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 網站：`npm run build:site` 把 web/dist 和 build/static 組成 build/site/。
  // run_worker_first：除了打包好的程式（/assets/*），都先經過 Worker，沒登入就回登入頁（網站本身也只給家人看）。
  // /assets/ 不用登入就讀得到，所以資料點、時刻表都不能放在那裡（資料在 D1 和 /static/，T15）
  "assets": {
    "directory": "../build/site",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
    // 網站沒有用路徑的路由：不存在的檔案回 404。SPA 模式會回 index.html（200），/assets/ 的長快取會把它記一年（T15 實測）
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  "vars": {
    // 開發用的固定身分的名字。DEV_AUTH 不放這裡：只有 `npm run dev:worker` 用 --var 傳 "1"，
    // 而且只認 localhost 的請求（src/auth.ts），正式環境和 ngrok 通道都要 LINE 登入
    "DEV_MEMBER_ID": "dev-user",
    "DEV_MEMBER_NAME": "開發者"
  }
}
