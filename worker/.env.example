# 本機開發用的設定（複製成 worker/.env 再填；.env 不進 git）。
# 正式環境不讀這個檔案：用 `npx wrangler secret put <名稱>`（在 worker/ 底下跑）。
# 每一項從哪裡拿，見 docs/architecture.md §4「設定值和 secret」。

# LINE Login channel → Basic settings
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Messaging API channel → Basic settings 的 Channel secret；Messaging API 分頁最下面發的 long-lived token
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
# 管理員的 LINE userId（U 開頭），逗號分隔
ADMIN_LINE_USER_IDS=

# 簽登入憑證用的亂數，至少 32 個字元：openssl rand -base64 32
SESSION_SECRET=
# 網站對外的網址。npm run dev:tunnel 會自動帶 https://<NGROK_DOMAIN>，這裡可以留空
PUBLIC_BASE_URL=

# 只有 npm run dev:tunnel 用（ngrok 後台）
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Claude API 代理（T16）
ANTHROPIC_API_KEY=
