{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-helper.local/schema/area.schema.json",
  "title": "區域（data/areas.json）",
  "description": "區域 ID 是另一個命名空間，可以和車站 ID 相同（例如區域 toba 和車站 toba）。",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/areaId"
      },
      "type": {
        "const": "area"
      },
      "name": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "municipality": {
        "description": "所屬的市町",
        "type": "string"
      },
      "definition": {
        "description": "這個區域包含哪些範圍（以行政區為準）",
        "type": "string"
      },
      "tripOrder": {
        "description": "行程順序：志摩 → 鳥羽 → 伊勢（含二見）→ 關西機場周邊",
        "type": "integer",
        "minimum": 1
      },
      "center": {
        "description": "地圖的預設中心",
        "$ref": "common.schema.json#/$defs/coords"
      },
      "bbox": {
        "description": "大致範圍（用來檢查座標，不是精確的行政界線）",
        "$ref": "common.schema.json#/$defs/bbox"
      },
      "stations": {
        "description": "區域內的車站 ID",
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "photos": {
        "description": "代表照片（T51）：探索概覽的卡片用，1 張；Wikimedia Commons 的照片要記 credit、license，sources 附 Commons 頁面",
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/photo"
        },
        "minItems": 1,
        "maxItems": 3
      },
      "notes": {
        "$ref": "common.schema.json#/$defs/nullableString",
        "description": "整理資料用的筆記，不給人看（給人看的寫在 intro）"
      },
      "sources": {
        "$ref": "common.schema.json#/$defs/sources"
      },
      "extra": {
        "type": "object"
      },
      "intro": {
        "$ref": "#/$defs/intro"
      },
      "regions": {
        "description": "子地區：搜尋、缺漏檢查、地圖篩選的單位",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "name": {
              "$ref": "common.schema.json#/$defs/name"
            },
            "center": {
              "$ref": "common.schema.json#/$defs/coords"
            },
            "needsCar": {
              "type": "boolean",
              "description": "大部分地點要搭車（巴士稀少）"
            },
            "note": {
              "$ref": "common.schema.json#/$defs/nullableString",
              "description": "整理資料用的筆記，不給人看（給人看的寫在 intro）"
            },
            "intro": {
              "$ref": "#/$defs/regionIntro"
            }
          },
          "required": [
            "id",
            "name",
            "center"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "type",
      "name",
      "municipality",
      "definition",
      "center",
      "bbox",
      "stations",
      "sources"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "intro": {
      "description": "給人看的區域介紹（T40）：探索的概覽、AI 共用。每段要有根據：basedOn（資料點 ID）或 sources（網址），至少一種。不寫「建議住幾晚」這類意見。",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "一句特色（30～50 字）：這區適合做什麼、要不要搭車；不寫行銷文案"
        },
        "transport": {
          "type": "string",
          "minLength": 1,
          "description": "要不要搭車的一句摘要"
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 5,
          "description": "代表的點：3～5 個這一區的資料點 ID，從 S、A 級挑，至少 1 間餐廳（這區沒有 S、A 級餐廳時例外）"
        },
        "february": {
          "type": "array",
          "description": "二月注意：休園、休業、換船這類，照重要的順序；沒有就空陣列",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "points": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "uniqueItems": true,
                "minItems": 1,
                "description": "整理自哪些資料點"
              },
              "sources": {
                "$ref": "common.schema.json#/$defs/sources"
              }
            },
            "required": [
              "text"
            ],
            "anyOf": [
              {
                "required": [
                  "points"
                ]
              },
              {
                "required": [
                  "sources"
                ]
              }
            ],
            "additionalProperties": false
          }
        },
        "basedOn": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true,
          "description": "summary、transport 整理自哪些資料點"
        },
        "sources": {
          "$ref": "common.schema.json#/$defs/sources"
        }
      },
      "required": [
        "summary",
        "transport",
        "highlights",
        "february"
      ],
      "anyOf": [
        {
          "required": [
            "basedOn"
          ],
          "properties": {
            "basedOn": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "sources"
          ]
        }
      ],
      "additionalProperties": false
    },
    "regionIntro": {
      "description": "給人看的子地區介紹（T40）。要不要搭車看子地區的 needsCar。",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "一句特色"
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 3,
          "description": "代表的點：1～3 個這個子地區的資料點 ID（子地區沒有資料點時可以是空的）"
        },
        "febNote": {
          "$ref": "common.schema.json#/$defs/nullableString",
          "description": "二月注意；沒有就 null"
        },
        "basedOn": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true,
          "description": "整理自哪些資料點"
        },
        "sources": {
          "$ref": "common.schema.json#/$defs/sources"
        }
      },
      "required": [
        "summary",
        "highlights",
        "febNote"
      ],
      "anyOf": [
        {
          "required": [
            "basedOn"
          ],
          "properties": {
            "basedOn": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "sources"
          ]
        }
      ],
      "additionalProperties": false
    }
  }
}
